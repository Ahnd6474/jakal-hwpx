!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/src/
!web/src/**
!web/studio/
!web/studio/**
!web/scripts/
!web/scripts/**
!web/public/
web/public/*
!web/public/fonts/
!web/public/fonts/**
!web/public/licenses/
!web/public/licenses/**
!web/public/favicon.svg
!web/public/404.html
!web/public/sample.hwp
!web/public/sample.hwpx
**/__pycache__/
**/*.pyc
**/.env*
**/*.sqlite*
**/*.pem
**/*.key
**/.web-data/
**/.web-test-data/
**/uploads/
**/private-uploads/
**/session-backups/
