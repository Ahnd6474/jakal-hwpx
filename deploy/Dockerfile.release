# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS node-runtime
FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 jakal \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp jakal \
    && install -d -m 0700 -o jakal -g jakal /var/lib/jakal
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY packages/ /tmp/packages/
RUN python -c "from glob import glob; from subprocess import check_call; import sys; wheel, = glob('/tmp/packages/*.whl'); check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir', wheel + '[web]'])" \
    && rm -rf /tmp/packages
WORKDIR /app
COPY app/ ./
COPY LICENSE THIRD_PARTY_NOTICES.md ./
ENV JAKAL_ENV=production JAKAL_HOST=0.0.0.0 JAKAL_DATA_DIR=/var/lib/jakal \
    HOME=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
RUN python -c "from server.runtime import check_runtime; check_runtime()"
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["python", "-m", "server.healthcheck"]
CMD ["python", "-m", "server"]
