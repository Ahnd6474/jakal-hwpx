{
    admin off
    auto_https off
}

:8080 {
    header -Server
    reverse_proxy app:8000 {
        # This gateway is published on host loopback only. Keep the normal
        # application's loopback-only policy; do not allow arbitrary peers.
        header_up X-Forwarded-For 127.0.0.1
        header_up X-Forwarded-Proto http
    }
}
